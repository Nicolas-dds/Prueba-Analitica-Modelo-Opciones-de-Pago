# Crear un archivo .env con estas variables.

# Clave de API real de OpenAI. Solo se usa si USE_REAL_LLM=1.
OPENAI_API_KEY=

# Poner en 1 para que el agente conversacional llame a OpenAI de verdad en vez del
# chat model fake determinista.
USE_REAL_LLM=1

# Poner en 0 para que sistema-agentico use el cliente de propensión fake en memoria
# en vez de llamar al servicio modelo-propension real dentro de Docker Compose.
USE_REAL_PROPENSION=0

# Poner en 1 para que sistema-agentico use el perfil/historial real derivado de
# data/prueba_op_base_pivot_var_rpta_alt_enmascarado_trtest.csv en vez del perfil
# sintético en memoria.
USE_REAL_PROFILE=0
